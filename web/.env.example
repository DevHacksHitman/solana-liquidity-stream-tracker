# Copy to .env and fill in your own values. Never commit .env.

# WebSocket stream used by the ticker widget (public data source)
VITE_PUMP_PORTAL_WS=wss://pumpportal.fun/api/data

# Optional: mint address to filter the ticker stream to one token.
# NOTE: per-token trade streams require a funded pumpportal API key; without
# one the ticker follows the free creation stream instead.
VITE_TOKEN_MINT=MyTokenMintAddressGoesHere

# Optional: funded pumpportal API key (never commit a real one)
# VITE_PUMP_PORTAL_API_KEY=
